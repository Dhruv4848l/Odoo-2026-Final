# Supabase Connection
# Provide these credentials to connect to the shared Supabase Postgres instance
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database URL for ORM (Prisma/Knex) connecting directly to Postgres
DATABASE_URL="postgres://postgres.[your-project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

PORT=3000
NODE_ENV=development
